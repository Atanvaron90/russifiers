    </div>
  </div>
</div>

<script>
// ================== НАСТРОЙКИ — ЗАПОЛНИ СВОЁ ==================
const CONFIG = {
  owner: "ВАШ_НИК_GITHUB",
  repo: "russifiers",
  branch: "main",
  dataFile: "data.json",        // ЕДИНЫЙ файл данных: каталог + название/слоган + донаты + контакты
  // Файлы ниже нужны только для чтения старой структуры при переходе;
  // после первого сохранения через ✏️ всё пишется в data.json, и их можно удалить из репозитория.
  donateFile: "donate.json",
  contactsFile: "contacts.json",
  siteFile: "site.json",
  counterNS: "my-russifiers-site", // УНИКАЛЬНОЕ имя для счётчиков!
  metricaId: "113956215",                 // номер счётчика Яндекс.Метрики (metrica.yandex.ru) — пусто = выключено
  // —— Загрузка файлов на диски через форму (необязательно) ——
  gdriveClientId: "",            // OAuth Client ID из Google Cloud Console (...apps.googleusercontent.com)
  yandexFolder: "Русификаторы"   // имя папки на обоих дисках — создаётся автоматически
};
const COUNTER_API = "https://abacus.jasoncameron.dev";

// ==== СЧЁТЧИК ПОСЕЩЕНИЙ (Яндекс.Метрика) ====
// Впишите в CONFIG.metricaId номер счётчика из https://metrica.yandex.ru — и статистика
// начнёт собираться автоматически: уникальные посетители (новые/вернувшиеся), визиты,
// переходы по внешним ссылкам (все ссылки на диски считаются сами), источники, карта кликов.
// Счётчик невидим для посетителей, панель статистики — только у вас (вход по Яндекс-аккаунту).
(function () {
  const id = parseInt(String(CONFIG.metricaId || "").trim(), 10);
  if (!id) return;
  window.ym = window.ym || function () { (window.ym.a = window.ym.a || []).push(arguments); };
  window.ym.l = 1 * new Date();
  window.ym(id, "init", { clickmap: true, linktrack: true, accurateTrackBounce: true, webvisor: false });
  const m = document.createElement("script");
  m.async = true;
  m.src = "https://mc.yandex.ru/metrika/tag.js";
  document.head.appendChild(m);
})();

// ==== БЛОК ДОНАТОВ ПО УМОЛЧАНИЮ (до первого сохранения через ✏️) ====
const DONATE_DEFAULT = {
  title: "☕ Поддержать автора",
  text: "Все русификаторы бесплатны. Если перевод оказался полезен, можно поблагодарить донатом.",
  methods: [
    { name: "Boosty", url: "https://boosty.to/atanvaron/donate", icon: "boostyto", color: "#F15F2C" },
    { name: "ЮMoney", url: "https://yoomoney.ru/to/4100XXXXXXXXXXXX", color: "#8B3FFE" },
    { name: "Карта — нажмите, чтобы скопировать", value: "0000 0000 0000 0000", color: "#2E7D32" }
  ]
};

// ==== БЛОК КОНТАКТОВ ПО УМОЛЧАНИЮ (до первого сохранения через ✏️) ====
const CONTACTS_DEFAULT = {
  title: "💬 Связь со мной",
  text: "Вопросы, предложения и сообщения о багах — в Telegram-канале.",
  contacts: [
    { name: "Telegram-канал", url: "https://t.me/atanvaron", icon: "telegram", color: "#26A5E4", note: "Новости и обновления" }
  ]
};

// ==== НАЗВАНИЕ И СЛОГАН ПО УМОЛЧАНИЮ (до первого сохранения через ✏️) ====
const SITE_DEFAULT = {
  name: "Русификаторы от Atanvaron",
  slogan: "Мои переводы и проекты — бесплатно"
};
// ============================================================

