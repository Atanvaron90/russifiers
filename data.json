});

function renderBadgePresets() {
  const seen = new Map();
  for (const p of state.projects) {
    const b = p.badge;
    if (b?.text) seen.set(b.text + "|" + (b.color || ""), b);
  }
  const box = $("badgePresets");
  const items = [...seen.values()];
  box.innerHTML = items.length
    ? '<span class="hint">Готовые ярлыки:</span>'
    : "";
  for (const b of items.slice(0, 12)) {
    const chip = document.createElement("button");
    chip.type = "button";
    chip.className = "badge-chip";
    chip.textContent = b.text;
    chip.style.cssText = badgeStyle(b.color);
    chip.addEventListener("click", () => {
      $("fBadgeOn").checked = true;
      $("fBadgeText").value = b.text;
      $("fBadgeColor").value = b.color || BADGE_DEFAULT.color;
