<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Русификаторы от Atanvaron</title>
<meta name="description" content="Бесплатные русификаторы для игр от Atanvaron">
<style>
  :root {
    --bg:#0f1117; --card:#1a1d27; --accent:#6c5ce7;
    --text:#e4e6eb; --muted:#9aa0ab; --border:#2a2e3d; --field:#232735;
  }
  * { margin:0; padding:0; box-sizing:border-box; }
  html, body { overflow-x: clip; }
  body { font-family:'Segoe UI',Arial,sans-serif; background:var(--bg); color:var(--text); padding-bottom:56px; }

  .sticky-top {
    position: sticky; top: 0; z-index: 20;
    background: rgba(15,17,23,.88);
    border-bottom: 1px solid var(--border);
    padding: 12px 0;
  }
  header { position:relative; text-align:center; padding:0 20px 8px; }
  .title-row { display:flex; align-items:stretch; justify-content:center; gap:16px; }
  .title-text { display:flex; flex-direction:column; justify-content:space-between; text-align:left; position:relative; }
  .title-text h1 { font-size:2rem; margin-bottom:4px; }
  .title-text p { color:var(--muted); font-size:.92rem; }
  /* Редактор названия: незаметная иконка рядом с текстом (только админ) */
  .title-edit {
    position:absolute; top:-2px; right:-30px;
    background:none; border:none; cursor:pointer;
    font-size:.95rem; opacity:.25; padding:4px; line-height:1;
  }
  .title-edit:hover { opacity:.9; }
  .site-logo {
    display:none;
    align-self:stretch;
    max-height:64px;
    width:auto;
    aspect-ratio:1/1;
    object-fit:cover;
    border:2px solid var(--accent);
    border-radius:50%;
    box-shadow:0 3px 16px rgba(108,92,231,.45);
  }
  .logo-fallback { display:none; align-self:center; font-size:2.4rem; }
  @media (max-width:640px) {
    .title-text h1 { font-size:1.45rem; }
    .site-logo { max-height:48px; }
    .title-edit { top:-4px; right:-28px; font-size:.85rem; }
  }

  .auth-btn {
    position:absolute; top:8px; right:22px;
    background:none; border:none; cursor:pointer;
    font-size:1.1rem; opacity:.4; padding:6px; line-height:1;
  }
  .auth-btn:hover { opacity:.9; }

  .toolbar { max-width:1000px; margin:0 auto; padding:0 20px; display:flex; gap:10px; flex-wrap:wrap; }

  .search-wrap { position:relative; flex:1; min-width:180px; align-self:flex-start; }
  #search { display:block; width:100%; padding:12px 52px 12px 16px; background:var(--card); border:1px solid var(--border); border-radius:10px; color:var(--text); font-size:1rem; }
  #search:focus { outline:none; border-color:var(--accent); }
  #search:focus ~ .filter-btn { border-color:var(--accent); }
  .filter-btn {
    position:absolute; right:0; top:0; height:100%; width:40px;
    display:inline-flex; align-items:center; justify-content:center;
    background:var(--field); border:1px solid var(--border); border-radius:0 10px 10px 0;
    color:var(--muted); cursor:pointer;
    transition: color .15s, border-color .15s, background .15s;
  }
  .filter-btn:hover { border-color:var(--accent); color:var(--text); }
  .filter-btn.on { background:var(--accent); border-color:var(--accent); color:#fff; }
  .search-toggle {
    display:none; align-items:center; justify-content:center;
    width:46px; padding:12px 0;
    background:var(--card); border:1px solid var(--border); border-radius:10px;
    color:var(--muted); cursor:pointer;
    transition: color .15s, border-color .15s;
  }
  .search-toggle:hover { border-color:var(--accent); color:var(--text); }
  .search-toggle.on { background:var(--accent); border-color:var(--accent); color:#fff; }
  @keyframes searchSlide { from { opacity:0; transform:translateX(-10px); } to { opacity:1; transform:none; } }
  .filter-panel, .settings-panel, .v-panel {
    position:absolute; top:calc(100% + 8px); z-index:30;
    background:var(--card); border:1px solid var(--border); border-radius:12px;
    padding:12px; box-shadow:0 12px 30px rgba(0,0,0,.5);
    display:flex; flex-direction:column; gap:8px; align-items:stretch;
  }
  .filter-panel { left:0; right:0; }
  .settings-panel, .v-panel { right:0; }
  .settings-panel { width:200px; }
  .v-panel { min-width:190px; }
  .filter-panel.hidden, .settings-panel.hidden, .v-panel.hidden { display:none; }
  .v-row { display:flex; justify-content:space-between; align-items:baseline; gap:16px; font-size:.9rem; }
  .v-row span { color:var(--muted); }
  .v-row b { color:var(--text); font-size:1rem; }
  .filter-panel .f-title, .settings-panel .f-title { width:100%; font-size:.78rem; color:var(--muted); }
  .f-chip {
    display:inline-flex; align-items:center; gap:6px;
    border:1px solid var(--border); border-radius:10px;
    padding:6px 12px; font-size:.82rem; font-weight:600;
    cursor:pointer; font-family:inherit; background:var(--field); color:var(--text);
  }
  .f-chip:hover { border-color:var(--accent); }
  .f-chip.sel { border-color:var(--accent); box-shadow:0 0 0 1px var(--accent); }
  .f-chip .n { opacity:.65; font-weight:400; }
  .s-row label { display:block; font-size:.72rem; color:var(--muted); }
  .s-row select { margin-top:4px; padding:8px 10px; background:var(--field); border:1px solid var(--border); border-radius:8px; color:var(--text); font-size:.9rem; cursor:pointer; width:100%; }
  .gear-btn {
    padding:12px; background:var(--card); border:1px solid var(--border); border-radius:10px;
    color:var(--muted); cursor:pointer; font-size:1rem;
    display:none; align-items:center; justify-content:center;
    transition: color .15s, border-color .15s;
  }
  .gear-btn:hover { border-color:var(--accent); color:var(--text); }
  .gear-btn.on { background:var(--accent); border-color:var(--accent); color:#fff; }

  #sortBy, #viewBy { padding:12px; background:var(--card); border:1px solid var(--border); border-radius:10px; color:var(--text); font-size:.95rem; cursor:pointer; }
  .stat-chip {
    align-self:center; padding:12px 14px; background:var(--card);
    border:1px solid var(--border); border-radius:10px;
    color:var(--text); font-size:.95rem; white-space:nowrap;
    margin-left:auto;
  }
  .uv-wrap { position:relative; align-self:center; display:inline-flex; margin-left:8px; }
  #statVisitors { cursor:pointer; font-family:inherit; }
  #statVisitors:hover { border-color:var(--accent); }
  .tool-btn { padding:12px 16px; background:var(--card); color:var(--text); border:1px solid var(--border); border-radius:10px; cursor:pointer; font-size:.95rem; }
  .tool-btn:hover { border-color:var(--accent); }
  .tool-btn.primary { background:var(--accent); border-color:var(--accent); color:#fff; font-weight:600; }
  .tool-btn:disabled { opacity:.5; cursor:default; }
  #btnAdd { margin-left:auto; }
  #btnAdd .m-short { display:none; }
  body:not(.admin) .admin-only { display:none !important; }

  .banner { max-width:1000px; margin:14px auto 0; padding:14px 18px; background:#241f33; border:1px solid var(--accent); border-radius:12px; color:#d9d3f5; font-size:.92rem; line-height:1.5; }

  .grid { max-width:1000px; margin:20px auto 30px; padding:0 20px; display:grid; grid-template-columns:repeat(auto-fill,minmax(290px,1fr)); gap:18px; }
  .card { position:relative; background:var(--card); border:1px solid var(--border); border-radius:14px; padding:16px; display:flex; flex-direction:column; gap:10px; cursor:pointer; transition:transform .15s,border-color .15s; }
  .card:hover { transform:translateY(-4px); border-color:var(--accent); }
  .card h2 { font-size:1.15rem; padding-right:56px; }
  .card:hover h2 { color:#a99cf5; }
  .cover { width:100%; aspect-ratio:460/215; object-fit:cover; border-radius:10px; background:var(--field); }
  .meta { font-size:.85rem; color:var(--muted); }
  .desc { font-size:.92rem; color:#c5c9d3; flex-grow:1; }
  .empty { grid-column:1/-1; text-align:center; color:var(--muted); padding:40px; }

  .card-actions { position:absolute; top:16px; right:16px; display:flex; gap:6px; z-index:2; }
  .icon-btn {
    background: rgba(31,35,48,.92); border: 1px solid var(--border);
    cursor: pointer; font-size: 1.05rem; opacity: .85;
    width: 38px; height: 38px;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: 10px; box-shadow: 0 4px 12px rgba(0,0,0,.35);
    transition: opacity .15s, border-color .15s, color .15s;
  }
  .icon-btn:hover { opacity: 1; border-color: var(--accent); color: #a99cf5; }

  .stale-badge {
    position:absolute; top:16px; left:16px; z-index:2;
    display:inline-flex; align-items:center; gap:5px;
    border:1px solid rgba(0,0,0,.2);
    font-size:.72rem; font-weight:700;
    padding:4px 9px; border-radius:10px;
    white-space:nowrap;
  }

  .grid.view-compact { grid-template-columns:1fr; gap:0; max-width:640px; margin-bottom:30px; }
  .grid.view-compact .card {
    background:none; border:none; border-radius:0;
    padding:7px 14px; gap:0; transform:none;
  }
  .grid.view-compact .card:hover { transform:none; border-color:transparent; background:rgba(108,92,231,.09); }
  .grid.view-compact .card h2 {
    font-size:1rem; font-weight:500; padding-right:40px;
    white-space:nowrap; overflow:hidden;
  }
  .grid.view-compact .card h2 > span { display:inline-block; will-change:transform; }
  .grid.view-compact .card:hover h2 { color:#a99cf5; }
  .grid.view-compact .card .cover,
  .grid.view-compact .card .desc,
  .grid.view-compact .card .meta,
  .grid.view-compact .card .stale-badge { display:none; }
  .grid.view-compact .card-actions { top:50%; right:8px; transform:translateY(-50%); }
  .grid.view-compact .icon-btn { width:34px; height:34px; font-size:.95rem; }

  @media (max-width:640px) {
    .grid:not(.view-compact) { grid-template-columns:1fr; gap:12px; padding:0 12px; margin:16px auto 24px; }
    .grid:not(.view-compact) .card {
      display:grid; grid-template-columns:minmax(96px, 36%) 1fr; gap:4px 12px;
      align-items:start; padding:10px;
    }
    .grid:not(.view-compact) .card .cover {
      grid-column:1; grid-row:1 / span 3;
      width:100%; height:auto;
      aspect-ratio:460/215;
      border-radius:8px;
      align-self:start;
    }
    .grid:not(.view-compact) .card h2,
    .grid:not(.view-compact) .card .desc,
    .grid:not(.view-compact) .card .meta { grid-column:2; }
    .grid:not(.view-compact) .card h2 { font-size:1rem; padding-right:8px; margin-top:0; }
    body.admin .grid:not(.view-compact) .card h2 { padding-right:84px; }
    .grid:not(.view-compact) .card .desc { font-size:.84rem; flex-grow:0; }
    .grid:not(.view-compact) .card .meta { font-size:.74rem; }
    .grid:not(.view-compact) .card-actions { top:6px; right:6px; gap:4px; }
    .grid:not(.view-compact) .card .icon-btn { width:32px; height:32px; font-size:.9rem; }
    .grid:not(.view-compact) .card .stale-badge {
      top:10px; left:10px;
      font-size:.68rem; font-weight:700;
      padding:3px 8px; border-radius:8px;
    }
    .toolbar { position:relative; padding:0 12px; row-gap:10px; }
    .toolbar .m-hide { display:none !important; }
    .search-toggle { display:inline-flex; }
    .toolbar.search-open .search-toggle { display:none; }
    .search-wrap { display:none; order:1; flex:1 1 0; min-width:0; }
    .toolbar.search-open .search-wrap {
      display:block;
      position:absolute; left:12px; right:12px; top:0; z-index:35;
      background:var(--bg);
      animation:searchSlide .18s ease;
    }
    .gear-btn { display:inline-flex; order:2; }
    .stat-chip { order:3; margin-left:0; }
    .uv-wrap { order:3; }
    #btnAdd { order:4; margin-left:0; padding:12px; font-size:.9rem; }
    #btnAdd .m-full { display:none; }
    #btnAdd .m-short { display:inline; }
    .grid.view-compact { max-width:none; padding:0 8px; }
    body.admin .grid.view-compact .card h2 { padding-right:84px; }
  }

  .overlay { position:fixed; inset:0; background:rgba(0,0,0,.7); display:flex; align-items:center; justify-content:center; z-index:50; padding:16px; }
  .overlay.hidden { display:none; }
  .modal { background:var(--card); border:1px solid var(--border); border-radius:14px; padding:24px; width:100%; max-width:560px; max-height:92vh; overflow:auto; }
  .modal h2 { font-size:1.2rem; margin-bottom:12px; }
  .modal label { display:block; font-size:.82rem; color:var(--muted); margin:12px 0 4px; }
  .modal input, .modal textarea, .modal select { width:100%; padding:10px 12px; background:var(--field); border:1px solid var(--border); border-radius:8px; color:var(--text); font-size:.95rem; }
  .modal input:focus, .modal textarea:focus { outline:none; border-color:var(--accent); }
  .hint { font-size:.8rem; color:var(--muted); margin-top:10px; line-height:1.5; }
  .f-note { font-size:.8rem; color:#a99cf5; margin-top:4px; line-height:1.5; }
  .f-note a { color:#a99cf5; text-decoration:underline; }
  .modal-actions { display:flex; gap:10px; justify-content:flex-end; margin-top:18px; flex-wrap:wrap; }

  .modal .flag-row { display:flex; align-items:center; gap:10px; margin-top:12px; cursor:pointer; }
  .flag-row input[type="checkbox"] { width:18px; height:18px; flex:none; cursor:pointer; accent-color:var(--accent); }
  .flag-row .flag-text { font-size:.9rem; color:var(--text); }

  .badge-edit { display:grid; grid-template-columns:1fr 48px; gap:8px; margin-top:8px; align-items:center; }
  .badge-edit input[type="color"] { padding:2px; height:42px; cursor:pointer; }
  .badge-presets { display:flex; flex-wrap:wrap; gap:8px; margin-top:8px; align-items:center; }
  .badge-chip {
    display:inline-flex; align-items:center;
    border:1px solid rgba(0,0,0,.2); border-radius:10px;
    font-size:.75rem; font-weight:700; padding:4px 10px;
    cursor:pointer; font-family:inherit;
  }
  .badge-chip:hover { filter:brightness(1.08); }

  .cover-preview { display:flex; gap:12px; margin-top:10px; align-items:flex-start; }
  .cover-preview.hidden { display:none; }
  .cover-preview img { width:180px; aspect-ratio:460/215; object-fit:cover; border-radius:8px; background:var(--field); flex:none; }
  .cov-right { flex:1; min-width:0; }
  .retry-search { background:none; border:1px solid var(--border); color:var(--text); border-radius:6px; padding:2px 10px; cursor:pointer; font-size:.8rem; margin-left:6px; }
  .retry-search:hover { border-color:var(--accent); color:#a99cf5; }

  /* Загрузка файлов на диски (в форме добавления) */
  .up-block { border:1px dashed var(--border); border-radius:10px; padding:12px; margin-top:12px; }
  .up-block > summary { cursor:pointer; user-select:none; }
  .up-head { display:flex; justify-content:space-between; align-items:center; font-size:.82rem; color:var(--muted); list-style:none; }
  .up-head::-webkit-details-marker { display:none; }
  .up-head::after { content:"▸"; transition:transform .2s; }
  .up-block[open] .up-head::after { transform:rotate(90deg); }
  .up-inner { margin-top:10px; }
  .up-row { display:flex; align-items:center; gap:10px; margin-top:8px; }
  .up-name { width:60px; flex:none; font-size:.85rem; }
  .up-bar { flex:1; height:8px; background:var(--field); border-radius:4px; overflow:hidden; }
  .up-bar > div { height:100%; width:0%; background:var(--accent); border-radius:4px; transition:width .25s; }
  .up-row.y .up-bar > div { background:#FC3F1D; }
  .up-row.g .up-bar > div { background:#34A853; }
  .up-state { width:150px; flex:none; font-size:.75rem; color:var(--muted); text-align:right; overflow-wrap:anywhere; }
  .up-state.err { color:#ff6b6b; }
  .up-state.ok  { color:#3ecf8e; }
  @media (max-width:600px) {
    .up-name { width:50px; font-size:.78rem; }
    .up-state { width:110px; font-size:.7rem; }
  }

  .steam-item { display:flex; align-items:center; gap:10px; width:100%; text-align:left; background:var(--field); color:var(--text); border:1px solid var(--border); border-radius:8px; padding:6px; margin-top:6px; cursor:pointer; font-size:.9rem; }
  .steam-item:hover { border-color:var(--accent); }
  .steam-item img { width:58px; height:27px; object-fit:cover; border-radius:4px; flex:none; }

  .lk-row { display:grid; grid-template-columns:auto 150px 1fr auto; gap:8px; align-items:center; border:1px dashed var(--border); border-radius:10px; padding:10px; margin-top:10px; }
  .lk-row input, .lk-row select { padding:8px 10px; font-size:.9rem; }
  .lk-order { display:flex; flex-direction:column; gap:2px; }
  .ord { background:none; border:none; color:var(--muted); cursor:pointer; font-size:.85rem; line-height:1; padding:2px 5px; }
  .ord:hover:not(:disabled) { color:var(--accent); }
  .ord:disabled { opacity:.25; cursor:default; }
  .ver-del { background:none; border:none; color:var(--muted); cursor:pointer; font-size:1rem; padding:4px; }
  .ver-del:hover { color:#ff6b6b; }
  @media (max-width:600px) {
    .lk-row { grid-template-columns:auto 1fr auto; }
    .l-type { grid-column:2; }
    .l-url  { grid-column:2; grid-row:2; }
  }

  .dn-row, .ct-row { display:grid; grid-template-columns:1fr 56px 130px auto; gap:8px; align-items:center; border:1px dashed var(--border); border-radius:10px; padding:10px; margin-top:10px; }
  .dn-row input, .ct-row input { padding:8px 10px; font-size:.9rem; }
  .dn-row .dn-color, .ct-row .ct-color { padding:2px; height:38px; cursor:pointer; }
  .dn-row .full, .ct-row .full { grid-column:1 / -1; }
  .dn-row .ver-del, .ct-row .ver-del { grid-column:4; grid-row:1; justify-self:center; padding:8px; }
  .dn-row .ver-del:hover, .ct-row .ver-del:hover { color:#ff6b6b; }

  /* Плашки донатов и контактов: донаты слева, контакты справа (десктоп);
     обе в потоке под сеткой на мобильных */
  .donate, .contacts { max-width:1000px; margin:0 auto 34px; padding:0 20px; }
  .donate-box, .contacts-box {
    position:relative;
    background:linear-gradient(135deg, rgba(108,92,231,.14), rgba(108,92,231,.04));
    border:1px solid rgba(108,92,231,.45); border-radius:14px; padding:18px 20px;
  }
  .contacts-box { background:linear-gradient(225deg, rgba(62,207,142,.12), rgba(62,207,142,.03)); border-color:rgba(62,207,142,.45); }
  .don-edit, .ct-edit { position:absolute; top:10px; right:10px; }
  .donate-box h3, .contacts-box h3 { font-size:1.05rem; margin-bottom:6px; }
  .donate-box p, .contacts-box p { font-size:.88rem; color:var(--muted); margin-bottom:12px; }
  .donate-list, .contacts-list { display:flex; flex-wrap:wrap; gap:10px; }
  .don-btn, .ct-btn {
    display:inline-flex; align-items:center; gap:8px; padding:9px 14px;
    background:var(--card); border:1px solid var(--border); border-radius:10px;
    color:var(--text); text-decoration:none; font-size:.9rem; cursor:pointer; font-family:inherit;
  }
  .don-btn:hover, .ct-btn:hover { border-color:var(--accent); }
  .ct-btn:hover { border-color:#3ecf8e; }
  .ct-item { display:flex; flex-direction:column; align-items:flex-start; gap:4px; max-width:100%; }
  .ct-item.has-note { width:100%; }
  .ct-note { font-size:.78rem; color:var(--muted); line-height:1.35; }
  .don-ico, .ct-ico {
    width:20px; height:20px; border-radius:5px;
    display:inline-flex; align-items:center; justify-content:center;
    font-size:.72rem; font-weight:700; color:#fff; flex:none;
  }
  .don-ico img, .ct-ico img { width:13px; height:13px; }
  body:not(.admin) #donate.no-methods,
  body:not(.admin) #contacts.no-methods { display:none; }

  @media (min-width: 1650px) {
    .donate {
      position: fixed;
      top: 152px;
      left: calc(50vw - 824px);
      width: 300px;
      max-width: none;
      margin: 0;
      padding: 0;
      z-index: 5;
    }
    .contacts {
      position: fixed;
      top: 152px;
      right: calc(50vw - 824px);   /* зеркально донатам — правый край */
      left: auto;
      width: 300px;
      max-width: none;
      margin: 0;
      padding: 0;
      z-index: 5;
    }
    .donate-box, .contacts-box { padding: 14px 16px; }
    .donate-box h3, .contacts-box h3 { font-size: 1rem; }
    .donate-box p, .contacts-box p { font-size: .82rem; margin-bottom: 10px; }
  }

  .modal.game { max-width:800px; padding:0; overflow:hidden; position:relative; }
  .g-top { position:absolute; top:10px; right:14px; z-index:2; display:flex; gap:8px; align-items:center; }
  .g-top .icon-btn {
    background: none; border-color: transparent; box-shadow: none;
    color: #9aa0ab;
  }
  .g-top .icon-btn:hover {
    background: none; border-color: transparent;
    color: #e4e6eb; transform: scale(1.15);
  }
  .g-grid { display:grid; grid-template-columns:250px 1fr; }
  .g-cover-link { display:flex; align-items:center; justify-content:center; background:var(--field); overflow:hidden; }
  .g-cover-link img { transition:filter .15s; }
  .g-cover-link.no-link { pointer-events:none; }
  .g-cover { width:100%; height:auto; max-height:82vh; object-fit:contain; background:var(--field); }
  .g-body { padding:20px 24px; min-height:340px; max-height:82vh; overflow:auto; }
  .g-body h2 { margin-bottom:6px; }
  .g-title-link { color:inherit; text-decoration:none; }
  .g-title-link:hover { color:#a99cf5; text-decoration:underline; }
  #gStale {
    margin-top:8px; display:none;
    align-self:flex-start;
    border:1px solid rgba(0,0,0,.2);
    font-size:.72rem; font-weight:700;
    padding:4px 9px; border-radius:10px; white-space:nowrap;
  }
  .g-body h3 { font-size:.92rem; margin:13px 0 2px; color:var(--muted); }
  .lk { display:flex; align-items:center; gap:10px; padding:7px 10px; border:1px solid var(--border); border-radius:10px; margin-top:8px; background:var(--field); }
  .lk-ico { width:32px; height:32px; border-radius:8px; display:flex; align-items:center; justify-content:center; flex:none; font-size:.88rem; }
  .lk-ico img { width:16px; height:16px; }
  .lk-info { flex:1; font-size:.88rem; line-height:1.25; }
  .lk-info .cnt { display:block; font-size:.74rem; color:var(--muted); }
  .lk-btn { padding:6px 14px; background:var(--accent); color:#fff; border-radius:8px; text-decoration:none; font-size:.84rem; font-weight:600; white-space:nowrap; }
  .lk-btn:hover { filter:brightness(1.15); }
  @media (max-width:640px) {
    .g-grid { grid-template-columns:1fr; }
    .g-cover-link { order:-1; }
    .g-cover { height:auto; min-height:0; max-height:none; aspect-ratio:460/215; object-fit:contain; }
    .g-body { padding:18px; }
  }

  .scroll-btn {
    position: fixed; right: 16px; bottom: 56px; z-index: 90;
    display: inline-flex; align-items: center; justify-content: center;
    width: 46px; height: 46px;
    border: 1px solid var(--border); border-radius: 10px;
    background: rgba(31,35,48,.92); color: var(--text);
    font-size: 1.15rem; cursor: pointer;
    font-family: inherit; box-shadow: 0 6px 20px rgba(0,0,0,.45);
    opacity: 0; pointer-events: none; transform: translateY(8px);
    transition: opacity .25s, transform .25s;
  }
  .scroll-btn.show { opacity: 1; pointer-events: auto; transform: none; }
  .scroll-btn:hover { border-color: var(--accent); color: #a99cf5; }

  footer {
    position:fixed; bottom:0; left:0; right:0; z-index:10;
    text-align:center; color:var(--muted); padding:12px; font-size:.8rem;
    background:rgba(15,17,23,.88); border-top:1px solid var(--border);
  }

  .toasts { position:fixed; right:16px; bottom:56px; z-index:100; display:flex; flex-direction:column; gap:8px; max-width:min(340px, calc(100vw - 32px)); }
  .toast {
    background:#1f2330; border:1px solid var(--border); border-left:3px solid var(--accent);
    border-radius:10px; padding:10px 14px; font-size:.87rem; color:var(--text);
    box-shadow:0 6px 20px rgba(0,0,0,.45); animation:tin .25s ease; overflow-wrap:anywhere;
  }
  .toast.ok  { border-left-color:#3ecf8e; }
  .toast.err { border-left-color:#ff6b6b; }
  .toast.out { opacity:0; transition:opacity .35s; }
  @keyframes tin { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:none; } }
</style>
</head>
<body>

