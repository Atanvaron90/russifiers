// ---------- Счётчик переходов ----------
const hstr = s => { let h = 5381; for (const c of s) h = ((h * 33) ^ c.charCodeAt(0)) >>> 0; return h.toString(36); };
const linkKey = (p, l) => `${p.id}_${hstr(l.url)}`;
const getDl = (p, l) => Math.max(l.dl || 0, dlCache[linkKey(p, l)] || 0);
const totalDl = p => (p.links || []).reduce((s, l) => s + getDl(p, l), 0);
async function remoteGet(key) {
  try {
    const r = await fetch(`${COUNTER_API}/get/${CONFIG.counterNS}/${key}`);
    if (r.ok) return (await r.json()).value || 0;
  } catch (e) {}
  return null;
}
const remoteHit = key => fetch(`${COUNTER_API}/hit/${CONFIG.counterNS}/${key}`).catch(() => {});

let lastSync = 0;
async function syncCounters() {
  if (Date.now() - lastSync < 15000) return;
  lastSync = Date.now();
  let dirty = false;
  for (const p of state.projects)
    for (const l of (p.links || [])) {
      const k = linkKey(p, l);
      const remote = await remoteGet(k);
      if (remote != null && remote > (dlCache[k] || 0)) { dlCache[k] = remote; dirty = true; }
    }
  if (dirty) saveDl();
  render();
}

// ---------- Уникальные посещения (плашка видна только админу) ----------
const LS_UV_EVER = "russifiers_uv_ever";
const LS_UV_DAY = "russifiers_uv_day";
const uvDayKey = () => {
  const d = new Date();
  return "uvDay_" + d.getFullYear() + "_" + String(d.getMonth() + 1).padStart(2, "0") + "_" + String(d.getDate()).padStart(2, "0");
};
function countVisit() {
  try {
    if (state.token) return; // собственные визиты администратора не считаем
    if (!localStorage.getItem(LS_UV_EVER)) {
      remoteHit("uvTotal");
      localStorage.setItem(LS_UV_EVER, "1");
    }
    if (localStorage.getItem(LS_UV_DAY) !== uvDayKey()) {
      remoteHit(uvDayKey());
      localStorage.setItem(LS_UV_DAY, uvDayKey());
    }
  } catch (e) {}
}
async function showVisitors() {
  const [total, today] = await Promise.all([remoteGet("uvTotal"), remoteGet(uvDayKey())]);
  const fmt = v => (v == null ? "—" : v);
  const short = $("uvShort");
  if (short) short.textContent = fmt(total) + "/" + fmt(today);
  const tEl = $("uvTotal");
  const dEl = $("uvToday");
  if (tEl) tEl.textContent = fmt(total);
  if (dEl) dEl.textContent = fmt(today);
}
$("statVisitors").addEventListener("click", () => {
  const p = $("visitorsPanel");
  p.classList.toggle("hidden");
  if (!p.classList.contains("hidden")) showVisitors();
});
