const BADGE_DEFAULT = { text: "Не обновляется", color: "#F5C518" };
const BADGE_ALPHA = 0.88;
const hexToRgb = h => {
  const m = String(h || "").replace("#", "").trim();
  const v = m.length === 3 ? m.split("").map(c => c + c).join("") : m;
  if (!/^[0-9a-fA-F]{6}$/.test(v)) return null;
  const n = parseInt(v, 16);
  return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
};
const badgeTextColor = c => {
  const rgb = hexToRgb(c);
  if (!rgb) return "#1c1c1c";
  const lum = 0.2126 * rgb[0] + 0.7152 * rgb[1] + 0.0722 * rgb[2];
  return lum > 140 ? "#1c1c1c" : "#ffffff";
};
function badgeStyle(color, alpha = BADGE_ALPHA) {
  const rgb = hexToRgb(color) || hexToRgb(BADGE_DEFAULT.color);
  return `background:rgba(${rgb[0]},${rgb[1]},${rgb[2]},${alpha});color:${badgeTextColor(color)}`;
}
const badgeHTML = p => (p?.badge?.text)
  ? `<div class="stale-badge" style="${badgeStyle(p.badge.color)}">${esc(p.badge.text)}</div>`
  : "";

