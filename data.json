// ---------- Отрисовка ----------
const grid = $("grid");
let query = "";

function render() {
  const view = currentView();
  const fval = currentFilter();

  const list = state.projects
    .filter(p => !query || p.title.toLowerCase().includes(query))
    .filter(p => !fval || p.badge?.text === fval)
    .sort(SORTS[currentSort()].fn);

  updateFilterBtn();

  const total = state.projects.length;
  $("statCount").textContent = (query || fval)
    ? `Найдено: ${list.length} из ${total}`
    : `${total} ${pluralRu(total, "русификатор", "русификатора", "русификаторов")}`;

  grid.innerHTML = "";
  if (!list.length) {
    grid.innerHTML = `<div class="empty">${(query || fval)
      ? "По заданным условиям ничего не найдено"
      : (state.token ? "Пока ничего нет — нажмите «Добавить русификатор»" : "Пока ничего не опубликовано 😕")}</div>`;
    return;
  }
  for (const p of list) {
    const services = dedupe((p.links || [])
      .map(l => (SERVICES[l.type] || SERVICES.other).name));
    grid.insertAdjacentHTML("beforeend", `
      <div class="card" data-id="${esc(p.id)}">
        ${badgeHTML(p)}
        <div class="card-actions admin-only">
          <button class="icon-btn edit" title="Редактировать">✏️</button>
          <button class="icon-btn del" title="Удалить">🗑️</button>
        </div>
        <img class="cover" alt="">
        <h2><span>${esc(p.title)}</span></h2>
        ${p.description ? `<p class="desc">${esc(p.description)}</p>` : ""}
        ${services.length ? `<div class="meta">${esc(services.join(" • "))}</div>` : ""}
      </div>`);
    if (view !== "compact")
      setCoverCascade(grid.lastElementChild.querySelector(".cover"), coverURLs(p));
  }

  if (view === "compact") requestAnimationFrame(setupMarquees);
}

function setupMarquees() {
  const old = document.getElementById("mqStyles");
  if (old) old.remove();
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

  let rules = "", n = 0;
  grid.querySelectorAll(".card h2").forEach(h => {
    const span = h.querySelector("span");
    if (!span) return;
    span.style.animation = "";
    span.style.transform = "";
    if (h.scrollWidth <= h.clientWidth + 1) return;
    const dist = h.scrollWidth - h.clientWidth + 14;
    const name = "mqrun" + (++n);
    const dur = Math.max(6, Math.round(dist / 28));
    rules += `@keyframes ${name}{0%,12%{transform:translateX(0)}88%,100%{transform:translateX(-${dist}px)}}`;
    span.style.animation = `${name} ${dur}s ease-in-out infinite alternate`;
  });
  if (rules) {
    const st = document.createElement("style");
    st.id = "mqStyles";
    st.textContent = rules;
    document.head.appendChild(st);
  }
}
let mqResizeTimer = null;
window.addEventListener("resize", () => {
  clearTimeout(mqResizeTimer);
  mqResizeTimer = setTimeout(() => {
    if (currentView() === "compact") setupMarquees();
  }, 200);
});
if (document.fonts && document.fonts.ready) {
  document.fonts.ready.then(() => {
    if (currentView() === "compact") setupMarquees();
  });
}

