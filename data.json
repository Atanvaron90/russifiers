function refreshOrder() {
  const rows = [...$("lkList").querySelectorAll(".lk-row")];
  rows.forEach((r, i) => {
    r.querySelector(".ord.up").disabled = i === 0;
    r.querySelector(".ord.down").disabled = i === rows.length - 1;
  });
}

 $("btnAdd").addEventListener("click", () => openForm());
