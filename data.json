  render();
});

// ---------- Фильтр по ярлыкам ----------
function currentFilter() {
  return localStorage.getItem(LS_FILTER) || "";
}
function renderFilterPanel() {
  const cur = currentFilter();
  const counts = new Map();
  for (const p of state.projects) {
    if (p.badge?.text) counts.set(p.badge.text, (counts.get(p.badge.text) || 0) + 1);
  }
  let html = '<div class="f-title">Фильтр по ярлыкам</div>';
  html += `<button type="button" class="f-chip ${cur === "" ? "sel" : ""}" data-f="">Все записи</button>`;
  for (const [t, n] of counts) {
    const b = state.projects.find(p => p.badge?.text === t)?.badge;
    html += `<button type="button" class="f-chip ${cur === t ? "sel" : ""}" data-f="${esc(t)}" style="${badgeStyle(b?.color)}">${esc(t)} <span class="n">${n}</span></button>`;
  }
  $("filterPanel").innerHTML = html;
}
function updateFilterBtn() {
  const cur = currentFilter();
  const btn = $("filterBtn");
  btn.classList.toggle("on", !!cur);
  btn.title = cur ? `Фильтр: ${cur} — нажмите, чтобы изменить` : "Фильтр по ярлыкам";
}
function toggleFilterPanel(force) {
  const panel = $("filterPanel");
  const open = typeof force === "boolean" ? force : panel.classList.contains("hidden");
  if (open) renderFilterPanel();
  panel.classList.toggle("hidden", !open);
}
 $("filterBtn").addEventListener("click", e => {
