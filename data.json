// ---------- Сортировка ----------
const SORTS = {
  az:  { fn: (a, b) => a.title.localeCompare(b.title, "ru", { sensitivity: "base" }) },
  za:  { fn: (a, b) => b.title.localeCompare(a.title, "ru", { sensitivity: "base" }) },
  dl:  { fn: (a, b) => totalDl(b) - totalDl(a) },
  new: { fn: (a, b) => (b.created || 0) - (a.created || 0) }
};
function currentSort() {
  const v = localStorage.getItem(LS_SORT);
  return SORTS[v] ? v : "az";
}

// ---------- Вид списка ----------
function currentView() {
  let v = localStorage.getItem(LS_VIEW);
  if (v === "list") v = "grid";
  return ["grid", "compact"].includes(v) ? v : "grid";
}
function applyView() {
  grid.classList.remove("view-grid", "view-list", "view-compact");
  grid.classList.add("view-" + currentView());
  $("viewBy").value = currentView();
  $("viewByM").value = currentView();
}
 $("viewBy").addEventListener("change", e => {
