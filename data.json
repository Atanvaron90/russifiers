function detectService(url) {
  try {
    const h = new URL(url).hostname.toLowerCase();
    for (const [k, s] of Object.entries(SERVICES))
      if (s.hosts.some(host => h === host || h.endsWith("." + host))) return k;
  } catch (e) {}
  return "other";
}
function makeIcon(type) {
  const s = SERVICES[type] || SERVICES.other;
  if (s.iconUrl)
    return `<span class="lk-ico" style="background:${s.color}"><img src="${s.iconUrl}" alt="" onerror="this.parentNode.style.color='${s.txt || "#fff"}';this.parentNode.textContent='${esc(s.fallback || s.name[0])}'"></span>`;
  if (!s.slug) return `<span class="lk-ico" style="background:${s.color};color:${s.txt || "#fff"}">${esc(s.fallback || "🔗")}</span>`;
  const fallbackJs = s.altSlug
    ? `this.onerror=()=>{this.parentNode.textContent='${esc(s.name[0])}'};this.src='https://cdn.simpleicons.org/${s.altSlug}/ffffff'`
    : `this.parentNode.textContent='${esc(s.name[0])}'`;
  return `<span class="lk-ico" style="background:${s.color}"><img src="https://cdn.simpleicons.org/${s.slug}/ffffff" alt="" onerror="${fallbackJs}"></span>`;
}

