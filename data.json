// ---------- Загрузка файлов на Яндекс.Диск и Google Drive ----------
const GDRIVE_SCOPE = "https://www.googleapis.com/auth/drive.file";
let gdToken = null, gdTokenExp = 0;

const yaToken = () => localStorage.getItem(LS_YA_TOKEN) || "";
const upBar = (id, pct) => { $(id).style.width = Math.max(0, Math.min(100, pct)) + "%"; };
const upState = (id, text, cls = "") => { const el = $(id); el.textContent = text; el.className = "up-state " + cls; };

function updateDriveStates() {
  const has = yaToken();
  upState("yaState", has ? "подключён" : "не подключён", has ? "ok" : "");
  upState("gdState", CONFIG.gdriveClientId ? "настроен" : "нет Client ID в CONFIG");
  upBar("yaBar", 0); upBar("gdBar", 0);
}

function xhrSend(url, { method = "PUT", headers = {}, body, onProgress } = {}) {
  return new Promise((resolve, reject) => {
    const xhr = new XMLHttpRequest();
    xhr.open(method, url);
    for (const [k, v] of Object.entries(headers)) xhr.setRequestHeader(k, v);
    if (onProgress) xhr.upload.onprogress = e => { if (e.lengthComputable) onProgress(e.loaded / e.total * 100); };
    xhr.onload = () => xhr.status >= 200 && xhr.status < 300 ? resolve(xhr) : reject(new Error("HTTP " + xhr.status));
    xhr.onerror = () => reject(new Error("сеть недоступна"));
    xhr.send(body);
  });
}

// —— Яндекс.Диск: один PUT (без докачки) + публикация ——
function yaApi(path, opts = {}) {
  return fetch("https://cloud-api.yandex.net" + path,
    { ...opts, headers: { Authorization: "OAuth " + yaToken(), ...(opts.headers || {}) } });
}
async function yaUpload(file, barId, stateId) {
  if (!yaToken()) throw new Error("токен не подключён");
  const folder = CONFIG.yandexFolder || "Русификаторы";
  upState(stateId, "папка…");
  const mkdir = await yaApi(`/v1/disk/resources?path=${encodeURIComponent("/" + folder)}`, { method: "PUT" });
  if (!mkdir.ok && mkdir.status !== 409) throw new Error("не создать папку (HTTP " + mkdir.status + ")");
  upState(stateId, "запрос…");
  let href = null;
  for (let i = 0; i < 5; i++) {
    const name = i ? file.name.replace(/(\.[^.]*)$/, ` (${i})$1`) : file.name;
    const p = "/" + folder + "/" + name;
    const r = await yaApi(`/v1/disk/resources/upload?path=${encodeURIComponent(p)}&overwrite=false`);
    if (r.status === 409) continue; // имя занято — пробуем «имя (2)»
    if (!r.ok) throw new Error("HTTP " + r.status);
    href = { url: (await r.json()).href, path: p };
    break;
  }
  if (!href) throw new Error("не нашлось свободное имя файла");
  upState(stateId, "загрузка…");
  await xhrSend(href.url, { body: file, onProgress: pct => { upBar(barId, pct); upState(stateId, Math.round(pct) + "%"); } });
  upState(stateId, "публикация…");
  const pub = await yaApi(`/v1/disk/resources/publish?path=${encodeURIComponent(href.path)}`, { method: "PUT" });
  if (!pub.ok) throw new Error("публикация HTTP " + pub.status);
  const link = (await pub.json()).href;
  upBar(barId, 100);
  upState(stateId, "готово", "ok");
  return link;
}

// —— Google Drive: resumable частями по 8 МБ (можно докачать) ——
function loadGsi() {
  if (window.google?.accounts?.oauth2) return Promise.resolve();
  return new Promise((resolve, reject) => {
    const s = document.createElement("script");
    s.src = "https://accounts.google.com/gsi/client";
    s.async = true;
    s.onload = resolve;
    s.onerror = () => reject(new Error("не удалось загрузить Google-клиент"));
    document.head.appendChild(s);
  });
}
function gdEnsureToken() {
  if (gdToken && Date.now() < gdTokenExp) return Promise.resolve(gdToken);
  if (!CONFIG.gdriveClientId) return Promise.reject(new Error("в CONFIG не заполнен gdriveClientId"));
  return loadGsi().then(() => new Promise((resolve, reject) => {
    try {
      google.accounts.oauth2.initTokenClient({
        client_id: CONFIG.gdriveClientId,
        scope: GDRIVE_SCOPE,
        callback: resp => {
          if (resp.error) return reject(new Error("Google: " + resp.error));
          gdToken = resp.access_token;
          gdTokenExp = Date.now() + Math.max((resp.expires_in || 3600) - 120, 60) * 1000;
          resolve(gdToken);
        },
        error_callback: err => reject(new Error("Google: " + (err?.message || err?.type || "окно закрыто")))
      }).requestAccessToken({});
    } catch (e) { reject(e); }
  }));
}
async function gdFolder(token) {
  const name = (CONFIG.yandexFolder || "Русификаторы").replace(/'/g, "\\'");
  const q = encodeURIComponent(`name='${name}' and mimeType='application/vnd.google-apps.folder' and trashed=false`);
  const found = await fetch(`https://www.googleapis.com/drive/v3/files?q=${q}&fields=files(id)`,
    { headers: { Authorization: "Bearer " + token } });
  if (found.ok) {
    const j = await found.json();
    if (j.files?.length) return j.files[0].id;
  }
  const made = await fetch("https://www.googleapis.com/drive/v3/files", {
    method: "POST",
    headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
    body: JSON.stringify({ name: CONFIG.yandexFolder || "Русификаторы", mimeType: "application/vnd.google-apps.folder" })
  });
  if (!made.ok) throw new Error("не создать папку (HTTP " + made.status + ")");
  return (await made.json()).id;
}
async function gdFinish(token, id, stateId) {
  upState(stateId, "публикация…");
  const perm = await fetch(`https://www.googleapis.com/drive/v3/files/${id}/permissions`, {
    method: "POST",
    headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
    body: JSON.stringify({ role: "reader", type: "anyone" })
  });
  if (!perm.ok) throw new Error("открыть доступ HTTP " + perm.status);
  upState(stateId, "готово", "ok");
  return `https://drive.google.com/file/d/${id}/view`;
}
async function gdUpload(file, barId, stateId) {
  if (!file.size) throw new Error("пустой файл");
  const token = await gdEnsureToken();
  upState(stateId, "папка…");
  const folderId = await gdFolder(token);
  upState(stateId, "запрос…");
  const init = await fetch("https://www.googleapis.com/upload/drive/v3/files?uploadType=resumable&fields=id", {
    method: "POST",
    headers: {
      Authorization: "Bearer " + token,
      "Content-Type": "application/json; charset=UTF-8",
      "X-Upload-Content-Type": file.type || "application/octet-stream",
      "X-Upload-Content-Length": String(file.size)
    },
    body: JSON.stringify({ name: file.name, parents: [folderId] })
  });
  if (!init.ok) throw new Error("сессия HTTP " + init.status);
  const loc = init.headers.get("Location") || init.headers.get("location");
  if (!loc) {
    // Резерв: адрес сессии не отдали — multipart одним запросом
    upState(stateId, "загрузка…");
    const fd = new FormData();
    fd.append("metadata", new Blob([JSON.stringify({ name: file.name, parents: [folderId] })], { type: "application/json" }));
    fd.append("file", file);
    const xhr = await xhrSend("https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart&fields=id", {
      method: "POST", headers: { Authorization: "Bearer " + token }, body: fd,
      onProgress: pct => { upBar(barId, pct); upState(stateId, Math.round(pct) + "%"); }
    });
    return await gdFinish(token, JSON.parse(xhr.responseText).id, stateId);
  }
  const chunk = 8 * 1024 * 1024;
  let offset = 0;
  while (true) {
    const end = Math.min(offset + chunk, file.size);
    upState(stateId, Math.round(end / file.size * 100) + "%");
    const r = await fetch(loc, {
      method: "PUT",
      headers: { "Content-Range": `bytes ${offset}-${end - 1}/${file.size}` },
      body: file.slice(offset, end)
    });
    if (r.status === 308) { offset = end; upBar(barId, end / file.size * 100); continue; }
    if (!r.ok) throw new Error("HTTP " + r.status);
    const id = (await r.json()).id;
    upBar(barId, 100);
    return await gdFinish(token, id, stateId);
  }
}

// —— Общий процесс: параллельно на оба диска ——
let uploading = false;
$("upBtn").addEventListener("click", () => {
  if (uploading) return;
  if (!yaToken() && !CONFIG.gdriveClientId) {
    toast("Сначала подключите хотя бы один диск", "err", 5000);
    openDrives();
    return;
  }
  $("upFile").click();
});
$("upFile").addEventListener("change", async () => {
  const file = $("upFile").files[0];
  $("upFile").value = "";
  if (!file || uploading) return;
  uploading = true;
  $("upBtn").disabled = true;
  let added = 0;
  const finishOne = link => {
    if (!link) return;
    addLinkRow({ type: detectService(link), url: link });
    refreshOrder();
    added++;
  };
  const tasks = [];
  if (yaToken()) tasks.push(
    yaUpload(file, "yaBar", "yaState").then(finishOne)
      .catch(e => { upState("yaState", "ошибка", "err"); toast("Яндекс.Диск: " + e.message, "err", 6000); }));
  if (CONFIG.gdriveClientId) tasks.push(
    gdUpload(file, "gdBar", "gdState").then(finishOne)
      .catch(e => { upState("gdState", "ошибка", "err"); toast("Google Drive: " + e.message, "err", 6000); }));
  await Promise.allSettled(tasks);
  if (added) toast(added === 1 ? "Готово: ссылка добавлена — не забудьте сохранить" : `Готово: добавлено ссылок — ${added}. Не забудьте сохранить`, "ok", 6000);
  uploading = false;
  $("upBtn").disabled = false;
});

// —— Окно «Подключить диски» ——
function openDrives() {
  $("yaTokenInput").value = yaToken();
  updateDriveStates();
  $("drivesModal").classList.remove("hidden");
  yaCheck();
}
async function yaCheck() {
  const el = $("yaStatus");
  if (!yaToken()) { el.textContent = "Токен не задан."; return; }
  el.textContent = "Проверяем токен…";
  try {
    const r = await yaApi("/v1/disk/");
    el.textContent = r.ok ? "Токен работает, Диск доступен." : "Токен не принят (HTTP " + r.status + ") — выпустите новый.";
  } catch (e) { el.textContent = "Не удалось связаться с Яндексом: " + e.message; }
}
$("drivesSetup").addEventListener("click", openDrives);
$("yaTokenSave").addEventListener("click", () => {
  const v = $("yaTokenInput").value.trim();
  if (v) localStorage.setItem(LS_YA_TOKEN, v); else localStorage.removeItem(LS_YA_TOKEN);
  updateDriveStates();
  yaCheck();
  toast(v ? "Токен Яндекс.Диска сохранён" : "Токен Яндекс.Диска удалён", "ok", 4000);
});
$("gdConnect").addEventListener("click", async () => {
  const el = $("gdStatus");
  el.textContent = "Открываем окно Google…";
  try {
    await gdEnsureToken();
    el.textContent = "Google Drive подключён. Токен действует ~1 час — после перерыва нажмите кнопку ещё раз.";
    upState("gdState", "подключён", "ok");
  } catch (e) {
    el.textContent = e.message;
  }
});
$("drivesClose").addEventListener("click", () => $("drivesModal").classList.add("hidden"));

// ---------- Сохранение ----------
 $("fSave").addEventListener("click", async () => {
  const btn = $("fSave");
  if (btn.disabled) return;
  if (!state.token) { alert("Войдите как администратор (иконка 🔐 вверху справа)"); return; }

  const title = $("fTitle").value.trim();
  if (!title) { alert("Введите название игры"); return; }

  const links = [];
  for (const b of document.querySelectorAll("#lkList .lk-row")) {
    const url = b.querySelector(".l-url").value.trim();
    if (!url) continue;
    if (!/^https?:\/\//i.test(url)) { alert("Ссылка должна начинаться с http:// или https://"); return; }
    links.push({ type: b.querySelector(".l-type").value, url, dl: 0 });
  }
  if (!links.length) { alert("Добавьте хотя бы одну ссылку на скачивание"); return; }

  const oldMap = new Map();
  if (editId) {
    const p = migrate(state.projects.find(x => x.id === editId));
    (p.links || []).forEach(l => oldMap.set(l.url, l));
  }
  links.forEach(l => { const o = oldMap.get(l.url); if (o) l.dl = o.dl || 0; });

  const c = effectiveCover();
  let cover = null;
  if (c) {
    if (c.url) cover = { url: c.url };
    else {
      cover = { appid: c.appid, name: c.name || appInfoCache[c.appid]?.name || "" };
      cover.url = c.header || steamHeaderURLs(c.appid)[0];
      if (c.capsule) cover.capsule = c.capsule;
    }
  }

  let badge = null;
  if ($("fBadgeOn").checked) {
    badge = {
      text: $("fBadgeText").value.trim() || BADGE_DEFAULT.text,
      color: $("fBadgeColor").value || BADGE_DEFAULT.color
    };
  }

  if (editId) {
    const p = state.projects.find(x => x.id === editId);
    Object.assign(p, { title, cover, links });
    if (badge) p.badge = badge; else delete p.badge;
    delete p.tags;
    delete p.stale;
  } else {
    state.projects.unshift({
      id: `${slugify(title)}-${Date.now().toString(36)}`,
      title, cover, links,
      ...(badge ? { badge } : {}),
      created: Date.now()
    });
  }

  const lbl = btn.textContent;
  btn.disabled = true; btn.textContent = editId ? "Сохраняю…" : "Публикую…";
  try {
    await writeData((editId ? "Обновлён: " : "Добавлен: ") + title);
  } catch (e) {
    toast("Не удалось сохранить data.json: " + e.message, "err", 6000);
    btn.disabled = false; btn.textContent = lbl;
    return;
  }
  btn.disabled = false; btn.textContent = lbl;
  render();
  closeForm();
  toast("Опубликовано! Посетители увидят изменения при следующем открытии сайта.", "ok", 5000);
});

for (const m of [$("loginModal"), $("gameModal")]) {
  m.addEventListener("click", e => { if (e.target === m) m.classList.add("hidden"); });
}
document.addEventListener("keydown", e => {
  if (e.key === "Escape") {
    $("loginModal").classList.add("hidden");
    $("gameModal").classList.add("hidden");
    toggleFilterPanel(false);
    $("settingsPanel").classList.add("hidden");
    $("gearBtn").classList.remove("on");
  }
});

function banner(text) {
  const d = document.createElement("div");
  d.className = "banner";
  d.innerHTML = text;
  grid.before(d);
}

(function setupScrollBtn() {
  const btn = $("scrollBtn");
  if (!btn) return;

  const toTop = () => window.scrollTo({ top: 0, behavior: "smooth" });

  let ticking = false;
  window.addEventListener("scroll", () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(() => {
        btn.classList.toggle("show", window.scrollY > window.innerHeight * 0.6);
        ticking = false;
      });
    }
  }, { passive: true });

  btn.addEventListener("click", toTop);
})();

(function setupGear() {
  const gear = $("gearBtn"), panel = $("settingsPanel");
  gear.addEventListener("click", e => {
    e.stopPropagation();
    const hidden = panel.classList.toggle("hidden");
    gear.classList.toggle("on", !hidden);
  });
  panel.addEventListener("click", e => e.stopPropagation());
})();

(async function init() {
  setAdmin(!!state.token);
  if (CONFIG.owner === "ВАШ_НИК_GITHUB") {
    renderSite(); renderDonate(); renderContacts(); applyView();
    grid.innerHTML = '<div class="empty">Сайт не настроен: заполните CONFIG в начале скрипта</div>';
    banner("⚠️ Заполните <b>CONFIG</b> (owner, repo, counterNS) и дефолтные блоки — см. настройки в начале скрипта.");
    return;
  }
  try { await loadData(); }
  catch (e) { banner("Не удалось загрузить данные из репозитория: " + esc(e.message)); }
  countVisit();
  renderSite();
  renderDonate();
  renderContacts();
  applyView();
  if (state.token) {
    gh("/user").then(u => { state.user = u.login; setAdmin(true); showVisitors(); })
      .then(() => autoHealCovers())
      .catch(e => {
        if (/401/.test(e.message)) {
          state.token = ""; localStorage.removeItem(LS_TOKEN); setAdmin(false);
          banner("⚠️ Токен истёк или отозван. Выпустите новый на GitHub и войдите заново.");
        }
      });
  }
  render();
})();
</script>

</body>
