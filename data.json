  const opts = Object.entries(SERVICES)
    .map(([k, s]) => `<option value="${k}" ${l.type === k ? "selected" : ""}>${s.name}</option>`).join("");
  box.innerHTML = `
    <div class="lk-order">
      <button type="button" class="ord up" title="Поднять выше">▲</button>
      <button type="button" class="ord down" title="Опустить ниже">▼</button>
