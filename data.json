let openedId = null;
const steamStoreURL = p => p.cover?.appid ? `https://store.steampowered.com/app/${p.cover.appid}/` : null;

// Высота окна игры подгоняется под высоту обложки слева; обложка не обрезается,
// а если ссылок много — они листаются внутри правой части.
function syncGameBody() {
  const body = $("gBody"), img = $("gCover");
  if ($("gameModal").classList.contains("hidden") || isNarrowScreen()) {
    body.style.maxHeight = "";
    return;
  }
  // 375 — высота высокой обложки 600×900 при ширине колонки 250px; 340 — прежний минимум окна
  const h = Math.round(img.getBoundingClientRect().height) || 375;
  body.style.maxHeight = Math.min(Math.round(window.innerHeight * 0.82), Math.max(h, 340)) + "px";
}
$("gCover").addEventListener("load", syncGameBody);
window.addEventListener("resize", syncGameBody);

function openGame(id) {
  const p = state.projects.find(x => x.id === id);
  if (!p) return;
  openedId = id;

  const store = steamStoreURL(p);
  const titleEl = $("gTitle");
  if (store) {
    titleEl.innerHTML = `<a class="g-title-link" href="${esc(store)}" target="_blank" rel="noopener" title="Открыть страницу игры в Steam">${esc(p.title)}</a>`;
  } else {
    titleEl.textContent = p.title;
  }
  const coverLink = $("gCoverLink");
  coverLink.removeAttribute("href");
  coverLink.classList.add("no-link");
  coverLink.removeAttribute("title");

  const st = $("gStale");
  const b = p.badge;
  if (b?.text) {
    st.textContent = b.text;
    st.style.background = badgeStyle(b.color).match(/background:([^;]+)/)[1];
    st.style.color = badgeTextColor(b.color);
    st.style.display = "inline-flex";
  } else {
    st.style.display = "none";
  }

  $("gDesc").textContent = p.description || "";
  $("gDesc").style.display = p.description ? "" : "none";

  setCoverCascade($("gCover"), gameCoverURLs(p));
  syncGameBody();

  const box = $("gLinks");
  box.innerHTML = "";
  const links = p.links || [];
  if (!links.length) box.innerHTML = '<p class="hint">Ссылки пока не добавлены.</p>';
  links.forEach((l, i) => {
    const s = SERVICES[l.type] || SERVICES.other;
    box.insertAdjacentHTML("beforeend", `
      <div class="lk">
        ${makeIcon(l.type)}
        <div class="lk-info"><b>${esc(s.name)}</b>
