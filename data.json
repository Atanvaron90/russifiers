const setNote = html => { $("fNote").innerHTML = html || ""; };

function effectiveCover() {
  const url = $("fCoverUrl").value.trim();
  if (url) return { url };
  const aid = extractAppId($("fAppId").value);
  if (aid) {
    const info = cachedInfo(aid) || {};
    const found = lastFound.find(x => x.id === aid);
    return {
      appid: aid,
      name: found?.name || info.name || "",
      header: info.header || "",
      capsule: info.capsule || ""
    };
  }
  return titlePick;
}

function updateCoverPreview() {
  const box = $("coverPreview"), img = $("covImg"), label = $("covLabel"), alts = $("covAlts");
  const c = effectiveCover();
  if (!c) { box.classList.add("hidden"); return; }
  box.classList.remove("hidden");
  alts.innerHTML = "";
  if (c.url) {
    label.textContent = "Обложка: своя ссылка на картинку";
    setCoverCascade(img, [c.url, phSVG("?")]);
  } else {
    label.textContent = c.name ? `Найдено в Steam: «${c.name}»` : `Обложка из Steam (AppID ${c.appid})`;
    setCoverCascade(img, dedupe([
      ...(c.appid ? steamHeaderURLs(c.appid) : []),
      c.header, c.capsule, ...(c.appid ? steamCapsuleURLs(c.appid) : []),
      phSVG("?")
    ]));
    const explicit = $("fAppId").value.trim() || $("fCoverUrl").value.trim();
    const others = lastFound.filter(x => x.id !== String(c.appid)).slice(0, 5);
    if (!explicit && others.length) {
      alts.innerHTML = '<span class="hint">Не та игра? Выберите другую:</span>' + others.map(x =>
        `<button type="button" class="steam-item" data-id="${esc(x.id)}" data-name="${esc(x.name)}">
           <img src="${esc(x.tiny || steamHeaderURLs(x.id)[0])}" alt="" onerror="this.onerror=null;this.src='${steamHeaderURLs(x.id)[1]}'">
           <span>${esc(x.name)}</span>
         </button>`).join("");
    }
  }
}

function queueTitleSearch(immediate = false) {
  clearTimeout(searchTimer);
  const seq = ++searchSeq;
  const q = $("fTitle").value.trim();
  if (q.length < 2 || $("fCoverUrl").value.trim() || extractAppId($("fAppId").value)) {
    updateCoverPreview();
    return;
  }
  const run = async () => {
    $("coverPreview").classList.remove("hidden");
    $("covImg").src = phSVG("…");
    $("covAlts").innerHTML = "";
    $("covLabel").textContent = "Ищу игру в Steam…";
    const res = await steamSearch(q);
    if (seq !== searchSeq) return;
    if (res && res.length) {
      lastFound = res;
      titlePick = { appid: res[0].id, name: res[0].name };
      updateCoverPreview();
    } else if (res) {
      lastFound = []; titlePick = null;
      $("covImg").src = phSVG("?");
      $("covLabel").textContent = "В Steam по этому названию ничего не найдено — проверьте название или вставьте ссылку / AppID в первое поле";
    } else {
      lastFound = []; titlePick = null;
      $("covImg").src = phSVG("?");
      $("covLabel").innerHTML = 'Steam-поиск заблокирован в этой сети (отключите блокировщик рекламы для сайта или впишите AppID в первое поле) <button type="button" class="retry-search">↻ Повторить</button>';
    }
  };
  if (immediate) run();
  else searchTimer = setTimeout(run, 500);
}

function queueAppIdLookup(immediate = false) {
  clearTimeout(appIdTimer);
  const seq = ++appIdSeq;
  const raw = $("fAppId").value.trim();
  const appid = extractAppId(raw);
  updateCoverPreview();
  if (!appid) return;
  if ((titleAuto || !$("fTitle").value.trim())) {
    const slugName = titleFromSlug(raw);
    if (slugName) {
      $("fTitle").value = slugName;
      setNote("Черновик названия из ссылки (Steam не хранит в ней знаки препинания) — получаю точное название и обложку из Steam…");
    } else {
      setNote("Получаю название и обложку из Steam…");
    }
  }
  const run = async () => {
    const info = await fetchAppInfo(appid);
    if (seq !== appIdSeq) return;
    if (info && (info.name || info.header)) {
      if (info.name) { titleAuto = true; $("fTitle").value = info.name; }
      updateCoverPreview();
      setNote(info.header
        ? "Название и обложка из Steam (точный адрес картинки) — можно отредактировать вручную."
        : "Название из Steam — можно отредактировать вручную.");
    } else {
      setNote(`Steam API недоступен из этой сети. Впиши название вручную — обложка по AppID подтянется. Сверить название: <a href="https://store.steampowered.com/app/${appid}/" target="_blank" rel="noopener">страница игры в Steam</a>`);
    }
  };
  if (immediate) run();
  else appIdTimer = setTimeout(run, 450);
}

