// ---------- Удаление ----------
async function deleteProject(id) {
  if (!state.token) { alert("Войдите как администратор (🔐 вверху справа)"); return false; }
  const p = state.projects.find(x => x.id === id);
  if (!p) return false;
  if (!confirm(`Удалить «${p.title}»? Запись исчезнет с сайта (можно вернуть откатом коммита в истории data.json).`)) return false;
  state.projects = state.projects.filter(x => x.id !== id);
  render();
  try {
    await writeData("Удалён: " + p.title);
    toast("Удалено: " + p.title, "ok", 3000);
  } catch (e) {
    toast("Запись убрана со страницы, но data.json не обновлён: " + e.message, "err", 6000);
  }
  return true;
}

grid.addEventListener("click", e => {
  const card = e.target.closest(".card");
  if (!card) return;
  const p = state.projects.find(x => x.id === card.dataset.id);
  if (!p) return;
  if (e.target.closest(".edit")) { openForm(p.id); return; }
  if (e.target.closest(".del")) { deleteProject(p.id); return; }
  openGame(p.id);
});

