function fetchTimeout(url, ms = 8000) {
  const ctrl = new AbortController();
  const t = setTimeout(() => ctrl.abort(), ms);
  return fetch(url, { signal: ctrl.signal }).finally(() => clearTimeout(t));
}

const STEAM_PROXIES = [
  { name:"direct",         wrap: u => u },
  { name:"codetabs",       wrap: u => "https://api.codetabs.com/v1/proxy/?quest=" + encodeURIComponent(u) },
  { name:"allorigins",     wrap: u => "https://api.allorigins.win/raw?url=" + encodeURIComponent(u) },
  { name:"allorigins-get", wrap: u => "https://api.allorigins.win/get?url=" + encodeURIComponent(u), json:"contents" },
  { name:"cors-lol",       wrap: u => "https://api.cors.lol/?url=" + encodeURIComponent(u) },
  { name:"cors-workers",   wrap: u => "https://test.cors.workers.dev/?" + u }
];
const failedCombos = new Set();

const SEARCH_SOURCES = [
  { name:"community", url: t => "https://steamcommunity.com/actions/SearchApps/" + encodeURIComponent(t),
    parse: j => Array.isArray(j) ? j.map(x => ({ id:String(x.appid ?? ""), name:x.name || "", tiny:x.icon || x.logo || "" })) : [] },
  { name:"storesearch", url: t => "https://store.steampowered.com/api/storesearch/?term=" + encodeURIComponent(t) + "&cc=US&l=russian",
    parse: j => (j && Array.isArray(j.items)) ? j.items.map(x => ({ id:String(x.id ?? x.appid ?? ""), name:x.name || "", tiny:x.tiny_capsule || "" })) : [] },
  { name:"htmlpage", url: t => "https://store.steampowered.com/search/?term=" + encodeURIComponent(t), html:true }
];
function parseSearchHTML(html) {
  const out = [];
  const dec = t => { const ta = document.createElement("textarea"); ta.innerHTML = t; return ta.value; };
  const re = /<a[^>]*data-ds-appid="(\d+)"[^>]*>[\s\S]*?<span class="title">([^<]*)<\/span>/g;
  let m;
  while ((m = re.exec(html)) && out.length < 7) {
    const id = m[1], name = dec(m[2] || "").trim();
    if (id && name) out.push({ id, name, tiny: "" });
  }
  return out;
}
function comboList() {
  const list = [];
  const saved = localStorage.getItem(LS_STEAM_COMBO);
  if (saved) {
    const [s, p] = saved.split(":").map(Number);
    if (SEARCH_SOURCES[s] && STEAM_PROXIES[p]) list.push([s, p]);
  }
  list.push([0, 0], [1, 0]);
  for (let p = 1; p < STEAM_PROXIES.length; p++) list.push([0, p], [1, p]);
  for (let p = 1; p < STEAM_PROXIES.length; p++) list.push([2, p]);
  return list;
}
async function steamSearch(term) {
  let anyAnswered = false;
  for (const [s, p] of comboList()) {
    const combo = s + ":" + p;
    if (failedCombos.has(combo)) continue;
    const src = SEARCH_SOURCES[s];
    const url = STEAM_PROXIES[p].wrap(src.url(term));
    try {
      const r = await fetchTimeout(url, 15000);
      if (!r.ok) throw new Error("HTTP " + r.status);
      const text = await r.text();
      let items;
      if (src.html) items = parseSearchHTML(text);
      else {
        let j; try { j = JSON.parse(text); } catch (e) { throw new Error("ответ не JSON"); }
        items = src.parse(j);
      }
      items = items.filter(x => x.id && x.name);
      if (items.length) {
        localStorage.setItem(LS_STEAM_COMBO, combo);
        return items.slice(0, 7);
      }
      anyAnswered = true;
    } catch (e) {
      failedCombos.add(combo);
      console.warn("Steam-поиск: маршрут не ответил —", src.name + "/" + STEAM_PROXIES[p].name, "(", e.message, ")");
    }
  }
  return anyAnswered ? [] : null;
}

const appInfoCache = (() => { try { return JSON.parse(localStorage.getItem(LS_APPNAMES)) || {}; } catch (e) { return {}; } })();
function cacheInfo(id, info) {
  appInfoCache[id] = info;
  const keys = Object.keys(appInfoCache);
  if (keys.length > 300) delete appInfoCache[keys[0]];
  localStorage.setItem(LS_APPNAMES, JSON.stringify(appInfoCache));
}
function cachedInfo(id) {
  const v = appInfoCache[id];
  if (!v) return null;
  return typeof v === "string" ? { name: v, header: "", capsule: "" } : v;
}
const APP_ROUTES = [
  { name:"appdetails", url: id => `https://store.steampowered.com/api/appdetails?appids=${id}&cc=US&l=russian`,
    parse: (j, id) => {
      const d = j && j[id];
      if (d && d.success && d.data) {
        return {
          name: String(d.data.name || ""),
          header: String(d.data.header_image || ""),
          capsule: String(d.data.capsule_imagev5 || d.data.capsule_image || "")
        };
      }
      return null;
    } },
  { name:"steamspy", url: id => `https://steamspy.com/api.php?request=appdetails&appid=${id}`,
    parse: j => (j && j.name) ? { name: String(j.name), header: "", capsule: "" } : null },
  { name:"htmlpage", url: id => `https://store.steampowered.com/app/${id}/?l=russian`, html: true }
];
function parseOgTitle(html) {
  const m = html.match(/<meta\s+property="og:title"\s+content="([^"]+)"/i)
        || html.match(/<title>([^<]+)<\/title>/i);
  if (!m) return null;
  let t = m[1].trim();
  t = t.replace(/^Save \d+% on\s+/i, "").replace(/^(Купить|Сохранить \d+% на|Скидка \d+% на)\s+/i, "");
  t = t.replace(/\s+(on Steam|в Steam)$/i, "");
  return t || null;
}
function parseOg(html) {
  const im = html.match(/<meta\s+property="og:image"\s+content="([^"]+)"/i);
  return {
    name: parseOgTitle(html) || "",
    header: im ? im[1].replace(/^http:/, "https:") : "",
    capsule: ""
  };
}
async function tryRoute(route, proxy, appid, ms) {
  const r = await fetchTimeout(proxy.wrap(route.url(appid)), ms);
  if (!r.ok) throw new Error("HTTP " + r.status);
  let text = await r.text();
  if (proxy.json) {
    try { text = JSON.parse(text)[proxy.json] || ""; } catch (e) { throw new Error("нет обёртки"); }
  }
  let info;
  if (route.html) {
    info = parseOg(text);
    if (!info.name && !info.header) throw new Error("og-теги не найдены");
  } else {
    let j; try { j = JSON.parse(text); } catch (e) { throw new Error("ответ не JSON"); }
    info = route.parse(j, appid);
    if (!info || (!info.name && !info.header)) throw new Error("пустой ответ");
  }
  return info;
}
async function fetchAppInfo(appid) {
  const cached = cachedInfo(appid);
  if (cached && cached.header) return cached;

  const saved = localStorage.getItem(LS_APP_ROUTE);
  if (saved) {
    const [ri, pi] = saved.split(":").map(Number);
    if (APP_ROUTES[ri] && STEAM_PROXIES[pi]) {
      try {
        const info = await tryRoute(APP_ROUTES[ri], STEAM_PROXIES[pi], appid, 8000);
        if (!info.name && cached?.name) info.name = cached.name;
        cacheInfo(appid, info);
        return info;
      } catch (e) {
        localStorage.removeItem(LS_APP_ROUTE);
        console.warn("Инфо по AppID: сохранённый маршрут не ответил —", APP_ROUTES[ri].name + "/" + STEAM_PROXIES[pi].name, "(", e.message, ")");
      }
    }
  }

  const tasks = [];
  for (let pi = 0; pi < STEAM_PROXIES.length; pi++)
    for (let ri = 0; ri < APP_ROUTES.length; ri++) {
      const route = APP_ROUTES[ri], proxy = STEAM_PROXIES[pi];
      if (route.html && proxy.name === "direct") continue;
      tasks.push(
        tryRoute(route, proxy, appid, 20000)
          .then(info => {
            localStorage.setItem(LS_APP_ROUTE, ri + ":" + pi);
            return info;
          })
          .catch(e => {
            console.warn("Инфо по AppID: не ответил —", route.name + "/" + proxy.name, "(", e.message, ")");
            throw e;
          })
      );
    }
  try {
    const info = await Promise.any(tasks);
    if (!info.name && cached?.name) info.name = cached.name;
    cacheInfo(appid, info);
    return info;
  } catch (e) {
    return cached && (cached.name || cached.header) ? cached : null;
  }
}

const extractAppId = s => { const m = String(s).match(/(\d{2,10})/); return m ? m[1] : null; };
const titleFromSlug = s => { const m = String(s).match(/steampowered\.com\/app\/\d+\/([^\/?#]+)/i); return m ? m[1].replace(/[_+]+/g, " ").trim() : ""; };

function migrate(p) {
  if (!Array.isArray(p.links)) {
    const flat = [];
    for (const v of (p.versions || []))
      for (const l of (v.links || []))
        if (l && l.url) flat.push(l);
    p.links = flat;
  }
  delete p.versions;
  p.links = (p.links || []).filter(l => l && l.url).map(l => ({
    type: l.type || detectService(l.url), url: l.url, dl: l.dl || 0
  }));
  if (p.stale && !p.badge) p.badge = { ...BADGE_DEFAULT };
  delete p.stale;
  if (p.badge && !p.badge.text) delete p.badge;
  return p;
}

function gh(path, opts = {}) {
  const headers = { Accept: "application/vnd.github+json", ...(opts.headers || {}) };
  if (state.token) headers.Authorization = "Bearer " + state.token;
  return fetch(GH_API + path, { ...opts, headers }).then(async r => {
    if (!r.ok) { let m = ""; try { m = (await r.json()).message || ""; } catch (e) {} throw new Error(`${r.status} ${m}`); }
    return r.json();
  });
}
function utf8B64(str) {
  const bytes = new TextEncoder().encode(str);
  let bin = "";
  for (let i = 0; i < bytes.length; i += 0x8000)
    bin += String.fromCharCode.apply(null, bytes.subarray(i, i + 0x8000));
  return btoa(bin);
}
async function getSha(file) {
  try {
    const j = await gh(`/repos/${CONFIG.owner}/${CONFIG.repo}/contents/${encPath(file)}?ref=${CONFIG.branch}`);
    return j.sha;
  } catch (e) { return null; }
}
async function putJson(file, obj, message, retried = false) {
  const body = { message, content: utf8B64(JSON.stringify(obj, null, 2)), branch: CONFIG.branch };
  const cached =
    file === CONFIG.dataFile ? state.dataSha :
    file === CONFIG.donateFile ? state.donateSha :
    file === CONFIG.contactsFile ? state.contactsSha :
    state.siteSha;
  const sha = cached || await getSha(file);
  if (sha) body.sha = sha;
  try {
    const res = await gh(`/repos/${CONFIG.owner}/${CONFIG.repo}/contents/${encPath(file)}`,
      { method: "PUT", body: JSON.stringify(body) });
    if (file === CONFIG.dataFile) state.dataSha = res.content.sha;
    else if (file === CONFIG.donateFile) state.donateSha = res.content.sha;
    else if (file === CONFIG.contactsFile) state.contactsSha = res.content.sha;
    else state.siteSha = res.content.sha;
  } catch (e) {
    if (!retried && /42[02]|409/.test(e.message)) {
      if (file === CONFIG.dataFile) state.dataSha = null;
      else if (file === CONFIG.donateFile) state.donateSha = null;
      else if (file === CONFIG.contactsFile) state.contactsSha = null;
      else state.siteSha = null;
      return putJson(file, obj, message, true);
    }
    throw e;
  }
}
// ---------- Единый файл данных: data.json = { name, slogan, donate, contacts, projects } ----------
const mergedData = () => ({
  name: state.site?.name || SITE_DEFAULT.name,
  slogan: state.site?.slogan || SITE_DEFAULT.slogan,
  donate: state.donate || DONATE_DEFAULT,
  contacts: state.contacts || CONTACTS_DEFAULT,
  projects: state.projects
});
const writeData = message => putJson(CONFIG.dataFile, mergedData(), message);
async function loadData() {
  // Дефолты — пока файлы не загружены (или их нет)
  state.site = { ...SITE_DEFAULT };
  state.donate = DONATE_DEFAULT;
  state.contacts = CONTACTS_DEFAULT;
  const r = await fetch(`https://raw.githubusercontent.com/${CONFIG.owner}/${CONFIG.repo}/${CONFIG.branch}/${CONFIG.dataFile}?t=${Date.now()}`);
  if (r.status === 404) {
    // data.json ещё не создан — читаем старые отдельные файлы (переходный период)
    state.projects = []; state.dataSha = null;
    await loadSite(); await loadDonate(); await loadContacts();
    return;
  }
  if (!r.ok) throw new Error("GitHub вернул " + r.status);
  const data = await r.json();
  if (Array.isArray(data)) {
    // Старый формат: в data.json только каталог, остальное — в отдельных файлах
    state.projects = data.filter(p => p && p.title).map(migrate);
    state.dataSha = null;
    await loadSite(); await loadDonate(); await loadContacts();
    return;
  }
  if (!data || typeof data !== "object") throw new Error("data.json имеет неверный формат");
  // Новый объединённый формат — все данные в одном файле
  if (typeof data.name === "string" || typeof data.slogan === "string")
    state.site = { name: data.name ?? SITE_DEFAULT.name, slogan: data.slogan ?? SITE_DEFAULT.slogan };
  if (data.donate && typeof data.donate === "object" && Array.isArray(data.donate.methods)) state.donate = data.donate;
  if (data.contacts && typeof data.contacts === "object" && Array.isArray(data.contacts.contacts)) state.contacts = data.contacts;
  state.projects = (Array.isArray(data.projects) ? data.projects : []).filter(p => p && p.title).map(migrate);
  state.dataSha = null;
}

