 $("lkList").addEventListener("click", e => {
  const row = e.target.closest(".lk-row");
  if (!row) return;
  if (e.target.closest(".ver-del")) { row.remove(); refreshOrder(); return; }
  if (e.target.closest(".ord.up") && row.previousElementSibling) {
