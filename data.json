// ---------- Авторемонт обложек ----------
const autoHealTried = new Set();
const isConstructedUrl = (p) => {
  const u = p.cover?.url;
  if (!u || !p.cover?.appid) return false;
  return new RegExp(`steamstatic\\.com\\/(steam|store_item_assets)\\/steam\\/apps\\/${p.cover.appid}\\/header\\.jpg$`, "i").test(u);
};
async function autoHealCovers() {
  if (!state.token) return;
  const need = state.projects.filter(p =>
    p.cover?.appid && (!p.cover.url || isConstructedUrl(p)) &&
    !cachedInfo(p.cover.appid)?.header && !autoHealTried.has(p.cover.appid));
  if (!need.length) return;
  let fixed = 0;
  for (const p of need) {
    autoHealTried.add(p.cover.appid);
    try {
      const info = await fetchAppInfo(p.cover.appid);
      if (info?.header && info.header !== p.cover.url) {
        p.cover.url = info.header;
        if (info.capsule) p.cover.capsule = info.capsule;
        fixed++;
      }
    } catch (e) {}
    await new Promise(r => setTimeout(r, 350));
  }
  if (fixed) {
    try {
      await writeData("Обложки: канонические URL из Steam");
      render();
      toast(`Обложки обновлены автоматически: ${fixed} шт.`, "ok", 5000);
    } catch (e) {
      console.warn("Авторемонт обложек: не удалось сохранить —", e.message);
    }
  }
}

