  }
}

function openForm(id = null) {
  if (!state.token) { alert("Сначала войдите как администратор (иконка 🔐 вверху справа)"); return; }
  editId = id;
  searchSeq++; appIdSeq++;
  clearTimeout(searchTimer); clearTimeout(appIdTimer);
  titlePick = null; lastFound = []; titleAuto = false;
  const p = id ? state.projects.find(x => x.id === id) : null;
  $("formModalTitle").textContent = p ? "Редактирование русификатора" : "Добавление русификатора";
  $("fSave").textContent = p ? "Сохранить" : "Опубликовать";
  $("fAppId").value = p?.cover?.appid ? String(p.cover.appid) : "";
  $("fTitle").value = p ? p.title : "";
  $("fCoverUrl").value = p?.cover?.url && !p.cover.appid ? p.cover.url : "";
  const b = p?.badge;
  $("fBadgeOn").checked = !!b;
  $("fBadgeText").value = b?.text || BADGE_DEFAULT.text;
  $("fBadgeColor").value = b?.color || BADGE_DEFAULT.color;
  renderBadgePresets();
  setNote("");
  $("lkList").innerHTML = "";
  const links = p?.links?.length ? p.links : [{}];
  links.forEach(addLinkRow);
  refreshOrder();
  updateCoverPreview();
  if (p?.cover?.appid && !cachedInfo(p.cover.appid)?.header) queueAppIdLookup(true);
  updateDriveStates();
  $("upBlock").open = false;
  $("formModal").classList.remove("hidden");
}
